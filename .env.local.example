# Local SQLite file (development)
DATABASE_URL=file:local.db

# Required for Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-here

# API Bearer token signing secret (jose HS256), used by /api/v1 — dedicated,
# NOT the same as AUTH_SECRET. Generate with: openssl rand -base64 32
API_JWT_SECRET=your-api-secret-here

# Comma-separated CORS allow-list for /api/v1 browser clients. Defaults to
# http://localhost:3000 when unset.
API_ALLOWED_ORIGINS=http://localhost:3000

# Google Analytics 4 — leave blank or omit to disable (e.g. in local dev/CI)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
